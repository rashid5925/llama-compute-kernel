#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Weights {
    float w[];
};
layout(set = 1, binding = 0) buffer Input {
    float x[];
};
layout(set = 1, binding = 1) buffer Output {
    float output_vec[];
};

layout(push_constant) uniform Constants {
    uint layer;
    uint dim;
    uint unused0;
    uint unused1;
    uint weight_offset;
} pc;

void main() {
    float sum = 0.0;
    for (uint i = 0; i < pc.dim; ++i) {
        sum += x[i] * x[i];
    }

    float rms = 1.0 / sqrt((sum / float(pc.dim)) + 1e-5);

    for (uint i = 0; i < pc.dim; ++i) {
        output_vec[i] = x[i] * rms * w[pc.weight_offset + i];
    }
}
