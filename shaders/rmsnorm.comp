#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Weights {
    float w[];
};
layout(set = 1, binding = 0) buffer State { 
    float s[]; 
};

layout(push_constant) uniform Constants {
    uint layer;
    uint dim;
    uint unused0;
    uint unused1;
    uint weight_offset;
    uint src_offset;
    uint dst_offset;
} pc;

void main() {
    float sum = 0.0;
    
    for (uint i = 0; i < pc.dim; ++i) {
        float val = s[pc.src_offset + i];
        sum += val * val;
    }

    float rms = sqrt(sum / float(pc.dim) + 1e-5f);
    float scale = 1.0f / rms;

    for (uint i = 0; i < pc.dim; ++i) {
        s[pc.dst_offset + i] = s[pc.src_offset + i] * scale * w[pc.weight_offset + i];
    }
}
