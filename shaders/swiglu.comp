#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) buffer State { 
    float s[]; 
};

layout(push_constant) uniform Constants {
    uint layer; 
    uint in_dim; 
    uint out_dim; 
    uint pos;
    uint weight_offset; 
    uint src_offset; 
    uint dst_offset;
    uint src2_offset; 
    uint head_size; 
    uint n_heads;
    uint kv_dim; 
    uint seq_len; 
    uint key_base; 
    uint value_base;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.in_dim) return;
    float v = s[pc.src_offset + i];          // hb  = W1·xb
    v *= 1.0 / (1.0 + exp(-v));              // silu
    v *= s[pc.src2_offset + i];              // hb2 = W3·xb
    s[pc.dst_offset + i] = v;
}
